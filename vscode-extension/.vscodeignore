# Never package files outside the extension directory. The workspace root is an
# npm workspace whose node_modules/bug-dhor symlink points back here; dependency
# traversal without --no-dependencies otherwise includes the entire repository.
../**

# Git metadata
.git/**
.gitignore
.gitattributes

# Editors, OS files, and local VS Code state
.vscode/**
.vscode-test/**
.idea/**
.DS_Store
**/.DS_Store
**/.gitkeep
*.swp

# Node dependencies. Only the staged production closure created by
# scripts/stageRuntimeDeps.js is shipped; all development packages are excluded.
node_modules/**
!node_modules/ajv/dist/*.js
!node_modules/ajv/dist/**/*.js
!node_modules/ajv/dist/**/*.json
!node_modules/ajv/package.json
!node_modules/ajv/LICENSE
!node_modules/ajv/README.md
!node_modules/fast-deep-equal/index.js
!node_modules/fast-deep-equal/react.js
!node_modules/fast-deep-equal/es6/*.js
!node_modules/fast-deep-equal/package.json
!node_modules/fast-deep-equal/LICENSE
!node_modules/fast-deep-equal/README.md
!node_modules/fast-uri/index.js
!node_modules/fast-uri/lib/*.js
!node_modules/fast-uri/package.json
!node_modules/fast-uri/LICENSE
!node_modules/fast-uri/README.md
!node_modules/json-schema-traverse/index.js
!node_modules/json-schema-traverse/package.json
!node_modules/json-schema-traverse/LICENSE
!node_modules/json-schema-traverse/README.md
!node_modules/require-from-string/index.js
!node_modules/require-from-string/package.json
!node_modules/require-from-string/license
!node_modules/require-from-string/readme.md

# Dependency source artifacts that are not needed at runtime
**/*.map
**/*.ts
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/spec/**
node_modules/**/benchmark/**
node_modules/**/.github/**

scripts/**

# Python environments and caches
.venv/**
venv/**
env/**
ENV/**
**/__pycache__/**
**/*.py[cod]
**/*.pyo
.pytest_cache/**
.mypy_cache/**
.ruff_cache/**

# Tests, coverage, and build output
test/**
**/*.test.js
coverage/**
htmlcov/**
.nyc_output/**
**/test-results/**
dist/**
build/**
*.egg-info/**
eslint.config.js

# Logs, temporary files, and local state
**/*.log
**/*.tmp
tmp/**
temp/**
.cache/**
.bugdhor-data/**
.bugdhor/**
artifacts/**
logs/**
*.sqlite
*.sqlite3
*.db

# Environment files and credentials
.env
.env.*
*.env

# Large model weights, checkpoints, and datasets
models/**
checkpoints/**
datasets/**
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.h5
*.bin

# Lockfiles and package artifacts
package-lock.json
yarn.lock
pnpm-lock.yaml
*.vsix

# Repository development artifacts and documentation output
docs/**
docs/build/**
site/**
.github/**
reports/**
outputs/**
benchmarks/results/**
