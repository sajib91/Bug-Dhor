{
  "name": "bug-dhor",
  "displayName": "Bug Dhor Security Framework",
  "description": "Explainable vulnerability analysis, counterfactual feature inspection, and verified repair for VS Code.",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "sae",
    "counterfactual",
    "repair"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:bugdhor.showStatus",
    "onCommand:bugdhor.showLogs",
    "onCommand:bugdhor.scanCurrentFile",
    "onCommand:bugdhor.scanSelection",
    "onCommand:bugdhor.scanWorkspace",
    "onCommand:bugdhor.explainVulnerability",
    "onCommand:bugdhor.analyzeSecurityFeatures",
    "onCommand:bugdhor.counterfactualAnalysis",
    "onCommand:bugdhor.generateSecureCode",
    "onCommand:bugdhor.repairVulnerability",
    "onCommand:bugdhor.verifyRepair",
    "onCommand:bugdhor.openSecurityDashboard",
    "onView:bugdhor.sidebar"
  ],
  "main": "./src/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "bugdhor.showStatus",
        "title": "Show Status",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.showLogs",
        "title": "Show Logs",
        "category": "Bug Dhor",
        "icon": "$(output)"
      },
      {
        "command": "bugdhor.scanCurrentFile",
        "title": "Scan Current File",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.scanSelection",
        "title": "Scan Selection",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.explainVulnerability",
        "title": "Explain Vulnerability",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.analyzeSecurityFeatures",
        "title": "Analyze Security Features",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.counterfactualAnalysis",
        "title": "Counterfactual Analysis",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.generateSecureCode",
        "title": "Generate Secure Code",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.repairVulnerability",
        "title": "Repair Vulnerability",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.verifyRepair",
        "title": "Verify Repair",
        "category": "Bug Dhor"
      },
      {
        "command": "bugdhor.openSecurityDashboard",
        "title": "Open Security Dashboard",
        "category": "Bug Dhor",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bugdhor.showLogs",
          "when": "view == bugdhor.sidebar",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bugdhor",
          "title": "Bug Dhor",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "bugdhor": [
        {
          "id": "bugdhor.sidebar",
          "name": "Security Dashboard",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Bug Dhor",
      "properties": {
        "bugdhor.backend.url": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "scope": "machine-overridable",
          "pattern": "^https?://[^\\s]+$",
          "markdownDescription": "Base URL of the running Bug Dhor FastAPI backend. Use only an HTTP or HTTPS origin with no credentials, path, query, or fragment. The extension appends `/api/v1` itself."
        },
        "bugdhor.backend.requestTimeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "scope": "machine-overridable",
          "description": "Timeout in milliseconds for scan and analysis requests. The request is aborted and reported to the user when it expires."
        },
        "bugdhor.backend.healthTimeoutMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 60000,
          "scope": "machine-overridable",
          "description": "Timeout in milliseconds for backend health checks."
        },
        "bugdhor.privacy.sendSourceText": {
          "type": "boolean",
          "default": true,
          "scope": "machine-overridable",
          "markdownDescription": "Send the active document text and selected text with explicitly user-invoked scan and analysis commands. Disable to send only file paths and ranges; the backend then reads the saved file from disk. Workspace scans never send file contents. Source text is not sent by health checks or automatically."
        },
        "bugdhor.backend.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Reserved for a future backend process manager. The extension currently connects to an already-running backend and does not start one."
        },
        "bugdhor.backend.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Reserved for a future backend process manager. The extension currently connects to an already-running backend and does not start one."
        },
        "bugdhor.logging.level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "off"
          ],
          "enumDescriptions": [
            "Show trace, debug, info, warning, and error messages.",
            "Show debug, info, warning, and error messages.",
            "Show info, warning, and error messages.",
            "Show warning and error messages.",
            "Show error messages only.",
            "Disable Bug Dhor output channel messages."
          ],
          "default": "info",
          "description": "Log level for the Bug Dhor output channel."
        },
        "bugdhor.ui.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show the Bug Dhor status bar item."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --ignore-path ../.prettierignore --write \"**/*.{js,json,css,html,yml,yaml}\"",
    "format:check": "prettier --ignore-path ../.prettierignore --check \"**/*.{js,json,css,html,yml,yaml}\"",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/integration/runTest.js",
    "package": "npm run package:vsix",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "package:list": "vsce ls --tree --no-dependencies"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
